{#- Transit profile for relay service users (architecture tasks 3.3 and 3.5).
    Source-address allowlisting of relay hosts is enforced by nftables on the
    exit node, not here. -#}
{%- import 'partials/common.j2' as common with context -%}
{%- set clients = namespace(items=[]) -%}
{%- for client_id in transit_client_ids -%}
{%-   set clients.items = clients.items + [{'id': client_id, 'email': 'egress-' ~ loop.index0}] -%}
{%- endfor -%}
{%- set inbounds = namespace(items=[]) -%}
{#- v6only keeps "::" from also claiming the IPv4 port of transit-v4. -#}
{%- for family, listen in [('v4', '0.0.0.0'), ('v6', '::')] -%}
{%-   set inbounds.items = inbounds.items + [{
        'tag': 'transit-' ~ family,
        'listen': listen,
        'port': transit_port | int,
        'protocol': 'vless',
        'settings': {'clients': clients.items, 'decryption': 'none'},
        'streamSettings': common.stream | combine({'sockopt': {'v6only': family == 'v6'}}),
        'sniffing': common.sniffing,
      }] -%}
{%- endfor -%}
{%- set profile = {
  'log': {'loglevel': 'warning'},
  'inbounds': inbounds.items,
  'outbounds': common.outbounds,
  'routing': common.routing,
} -%}
{{ profile | to_nice_json(indent=2, sort_keys=true) }}
