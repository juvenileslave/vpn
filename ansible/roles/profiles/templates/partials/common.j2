{#- Shared pieces of the exit and transit profiles. Import "with context". -#}
{%- set sniffing = {
  'enabled': true,
  'destOverride': ['http', 'tls', 'quic'],
  'routeOnly': true,
} -%}
{#- Architecture task 3.2: REALITY over XHTTP, no flow on any client. -#}
{%- set stream = {
  'network': 'xhttp',
  'xhttpSettings': {
    'path': xhttp_path,
    'mode': xhttp_mode,
    'xPaddingBytes': profiles_xpadding_bytes,
  },
  'security': 'reality',
  'realitySettings': {
    'show': false,
    'dest': reality_target,
    'xver': 0,
    'serverNames': [reality_sni],
    'privateKey': reality_private_key,
    'shortIds': reality_short_ids,
  },
} -%}
{#- Architecture task 3.5: freedom egress per egress_family. finalRules see
    the resolved address, so a domain resolving into a private range is
    blocked at dial time, not only by the routing rule. -#}
{%- set outbounds = [
  {
    'tag': 'egress',
    'protocol': 'freedom',
    'settings': {
      'finalRules': [
        {'action': 'block', 'ip': ['geoip:private'] + profiles_egress_family_block[egress_family]},
      ],
    },
    'streamSettings': {
      'sockopt': {'domainStrategy': profiles_egress_domain_strategy[egress_family]},
    },
  },
  {'tag': 'block', 'protocol': 'blackhole'},
] -%}
{%- set routing = {
  'domainStrategy': 'IPIfNonMatch',
  'rules': [
    {'type': 'field', 'ip': ['geoip:private'], 'outboundTag': 'block'},
    {'type': 'field', 'protocol': ['bittorrent'], 'outboundTag': 'block'},
  ],
} -%}
