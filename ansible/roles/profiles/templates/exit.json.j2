{#- Exit profile, inbound "direct" (architecture tasks 3.2 and 3.5). -#}
{%- import 'partials/common.j2' as common with context -%}
{%- set clients = namespace(items=[]) -%}
{%- for client_id in exit_direct_client_ids -%}
{%-   set clients.items = clients.items + [{'id': client_id, 'email': 'direct-' ~ loop.index0}] -%}
{%- endfor -%}
{%- set profile = {
  'log': {'loglevel': 'warning'},
  'inbounds': [
    {
      'tag': 'direct',
      'listen': '0.0.0.0',
      'port': exit_direct_port | int,
      'protocol': 'vless',
      'settings': {'clients': clients.items, 'decryption': 'none'},
      'streamSettings': common.stream,
      'sniffing': common.sniffing,
    },
  ],
  'outbounds': common.outbounds,
  'routing': common.routing,
} -%}
{{ profile | to_nice_json(indent=2, sort_keys=true) }}
