# Managed by Ansible (cp_backup). Non-secret settings only.
CP_BACKUP_DIR={{ cp_backup_dir }}
CP_BACKUP_RECIPIENTS_FILE=/etc/cp-backup/recipients.txt
CP_BACKUP_COMPOSE_PROJECT={{ cp_backup_compose_project }}
CP_BACKUP_COMPOSE_SERVICE={{ cp_backup_compose_service }}
CP_BACKUP_CONTAINER={{ cp_backup_container }}
CP_BACKUP_DB_NAME={{ cp_backup_db_name }}
CP_BACKUP_DB_USER={{ cp_backup_db_user }}
CP_BACKUP_KEEP_DAYS={{ cp_backup_keep_days }}
CP_BACKUP_KEEP_COUNT={{ cp_backup_keep_count }}
CP_BACKUP_LOCK_FILE=/run/lock/cp-backup.lock
CP_BACKUP_UNSAFE_SKIP_VERIFY={{ cp_backup_unsafe_skip_verify | bool | lower }}
